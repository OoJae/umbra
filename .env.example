# UMBRA — copy to .env and fill. TESTNET ONLY (Coston2, chain 114).
# .env is gitignored. Never commit real keys, never print them.

COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Three throwaway testnet accounts. Generate with `cast wallet new`.
# DEPLOYER deploys the contracts and owns TeeRegistry; ALICE is the buyer, BOB the seller.
# The TEE settlement key is generated inside the enclave at boot — you only fund its address.
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=
ALICE_PRIVATE_KEY=
ALICE_ADDRESS=
BOB_PRIVATE_KEY=
BOB_ADDRESS=

# Filled after the Phase 1 deploy (see docs/addresses.md)
VAULT_ADDRESS=
REGISTRY_ADDRESS=

# Token addresses verified in Phase 0 — see docs/addresses.md for source + verification command
FXRP_ADDRESS=
USDT0_ADDRESS=

# Engine
ENGINE_URL=http://localhost:8080
# simulated | confidential_space
TEE_MODE=simulated
# gates POST /batch/run — generate with `openssl rand -hex 16`
OPERATOR_TOKEN=
